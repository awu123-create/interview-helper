    "commander": "15.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
