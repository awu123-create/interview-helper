{
  "name": "interview-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "interview-helper": "dist/cli/main.js"
  },
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt --write src test scripts package.json tsconfig.json tsconfig.build.json .oxfmtrc.json .oxlintrc.json .dependency-cruiser.js .pre-commit-config.yaml",
    "format:check": "oxfmt --check src test scripts package.json tsconfig.json tsconfig.build.json .oxfmtrc.json .oxlintrc.json .dependency-cruiser.js .pre-commit-config.yaml",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src test scripts .dependency-cruiser.js",
    "test": "node --import tsx --test test/*.test.ts",
    "secrets": "gitleaks git --redact --log-opts=HEAD .",
    "layers": "dependency-cruise --config .dependency-cruiser.js --output-type err --no-cache src",
    "verify:offline": "tsx scripts/verify-offline.ts",
    "verify:live": "node --import tsx scripts/verify-live.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "better-sqlite3": "13.1.1",
    "commander": "15.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.19",
    "dependency-cruiser": "18.7.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.80.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
